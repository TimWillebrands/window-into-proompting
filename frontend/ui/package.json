        "@storybook/addon-vitest": "10.3.5",
        "@storybook/react-vite": "^10.3.5",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/browser": "^4.1.12",
        "@vitest/browser-playwright": "^4.1.12",
        "playwright": "^1.65.1",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "storybook": "^10.3.5",
        "typescript": "^5.7.2",
        "vite": "^8.0.7",
        "vitest": "^4.1.12"

{
    "name": "@partytown/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./tokens.css": "./src/tokens.css",

{
    "name": "proompting",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "copy-assets": "cp node_modules/streaming-markdown-component/dist/index.js public/vendor/streaming-md.js",
        "dev": "bun run copy-assets && concurrently \"wrangler dev 2>&1 | grep --line-buffered -v 'phg-9b7e'\" \"tailwindcss -i ./public/input.css -o ./public/output.css --watch\"",
        "deploy": "bun run copy-assets && tailwindcss -i ./public/input.css -o ./public/output.css && wrangler deploy --minify",
        "cf-typegen": "wrangler types --env-interface CloudflareBindings"
    },
    "dependencies": {
        "@proompting/core": "workspace:*",
        "@proompting/backend": "workspace:*",
        "@proompting/desktop": "workspace:*",
        "@proompting/party": "workspace:*",
        "@proompting/persona": "workspace:*",
        "@proompting/welcome": "workspace:*",
        "@clerk/backend": "^2.20.0",
        "@hono/clerk-auth": "^3.0.3",
        "@posthog/ai": "^7.1.0",
        "durable-utils": "^0.3.5",
        "eventsource-parser": "^3.0.6",
        "hono": "^4.9.6",
        "jsonrepair": "^3.13.1",
        "openai": "^5.23.0",
        "posthog-node": "^5.11.2",
        "streaming-markdown-component": "^0.1.5"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.3",
        "@types/bun": "^1.2.22",
        "concurrently": "^9.2.1",
        "tailwindcss": "^4.1.13",
        "wrangler": "^4.34.0"
    }
}

{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "proompting",
    "compatibility_date": "2025-09-02",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "binding": "ASSETS",
        "directory": "./public"
    },
    "observability": {
        "enabled": true
    },
    "main": "src/server.ts",
    "vars": {
        "PROD_ENV": "Production",
        "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsucHJvb21wdGluZy5wYXJ0eSQ",
        "LLM_PROVIDER": "openrouter",
        "OLLAMA_BASE_URL": "http://127.0.0.1:11434"
    }
}

{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "lib": ["ESNext", "DOM"],
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "declaration": true,
        "declarationMap": true,
        "composite": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "types": ["../../worker-configuration.d.ts"],
        "paths": {
            "@proompting/core": ["../core/src/index.ts"],
            "@proompting/core/*": ["../core/src/*"],
            "@proompting/desktop": ["../desktop/src/index.ts"]
        }
    },
    "include": ["src/**/*"],
    "references": [
        {
            "path": "../core"
        },
        {
            "path": "../desktop"
        }
    ]
}

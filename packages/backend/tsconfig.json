{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "lib": [
            "ESNext"
        ],
        "declaration": true,
        "declarationMap": true,
        "composite": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "types": [
            "../../worker-configuration.d.ts"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "references": [
        {
            "path": "../core"
        }
    ]
}
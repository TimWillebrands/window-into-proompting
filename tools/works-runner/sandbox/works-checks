#!/bin/bash
# Prints `::check name pass|fail seconds detail`. These live in the image so a patch can't soften its own checks.
cd /work || exit 1

step() {
    local name=$1 start=$SECONDS result=pass detail=
    shift
    "$@" >"/tmp/$name.log" 2>&1 || result=fail
    detail=$(grep -Eo 'Failed: +[0-9]+, Passed: +[0-9]+|Tests +[0-9]+( failed \| [0-9]+)? passed' "/tmp/$name.log" | tail -1 | tr -s ' ')
    if [ "$result" = fail ]; then detail="$detail $(grep -Eo '[A-Za-z0-9_.]+ \[FAIL\]|error [A-Z]+[0-9]+: .{0,80}' "/tmp/$name.log" | head -3 | tr '\n' ';')"; fi
    echo "::check $name $result $((SECONDS - start)) $detail"
    if [ "$result" = fail ]; then tail -15 "/tmp/$name.log"; fi
}

for _ in $(seq 1 60); do (echo >/dev/tcp/127.0.0.1/5455) 2>/dev/null && break; sleep 1; done

step backend-build dotnet build backend/backend.csproj -c Release
step backend-tests dotnet test backend-test/backend-test.csproj -c Release
cd frontend || exit 1
step frontend-install pnpm install --offline --frozen-lockfile
step frontend-lint pnpm check
step frontend-build pnpm build
step frontend-tests pnpm test
